sp_row <- which(x@data$NOMBRE == sp)
# Method to get biomodelo information
method(get_biomodelo, SpeciesData) <- function(x, sp) {
sp_row <- which(x@data$NOMBRE == sp)
if (length(sp_row) == 0) {
warning(paste("Species", sp, "not found in database"))
return(c(biomodelo = NA, estado = NA))
}
biomodelo <- x@data$Enlace_BioModelo[sp_row]
estado <- x@data$Estado[sp_row]
return(c(biomodelo = biomodelo, estado = estado))
}
