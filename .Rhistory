# Method to get full species information
method(get_species_info, SpeciesData) <- function(x, sp) {
sp_row <- which(x@data$NOMBRE == sp)
if (length(sp_row) == 0) {
warning(paste("Species", sp, "not found in database"))
return(NULL)
}
return(x@data[sp_row, ])
}
