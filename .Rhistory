library(S7)
# Define the SpeciesData S7 class
SpeciesData <- new_class(
"SpeciesData",
properties = list(
categ_table = class_data.frame
)
)
# Constructor function
species_data <- function(categ_table) {
SpeciesData(categ_table = categ_table)
}
# Method to get biomodelo information
method(get_biomodelo, SpeciesData) <- function(x, sp) {
sp_row <- which(x@categ_table$NOMBRE == sp)
if (length(sp_row) == 0) {
warning(paste("Species", sp, "not found in database"))
return(c(biomodelo = NA, estado = NA))
}
biomodelo <- x@categ_table$Enlace_BioModelo[sp_row]
estado <- x@categ_table$Estado[sp_row]
# Check if biomodelo is NA and print message
if (is.na(biomodelo)) {
biomodelo <- "no model"
}
return(c(biomodelo = biomodelo, estado = estado))
}
